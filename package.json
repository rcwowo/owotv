{
  "name": "owotv",
  "description": "A project to archive past VODs from Twitch.",
  "license": "MIT",
  "author": {
    "name": "Riley Wilson",
    "email": "riley@rcw.lol",
    "url": "https://rcw.lol"
  },
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bun --filter @owotv/web dev",
    "build": "bun --filter @owotv/web build",
    "preview": "bun --filter @owotv/web preview",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
