{
  "name": "owotv",
  "description": "A project to archive past VODs from Twitch.",
  "license": "MIT",
  "author": {
    "name": "Riley Wilson",
    "email": "riley@rcw.lol",
    "url": "https://rcw.lol"
  },
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "owotv": "./apps/cli/bin/owotv.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bun --filter @owotv/web dev",
    "build": "bun --filter @owotv/web build",
    "preview": "bun --filter @owotv/web preview",
    "deploy": "bun --filter @owotv/web deploy",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "db:generate": "bun --filter @owotv/db generate",
    "db:migrate:local": "bun --filter @owotv/web db:migrate:local",
    "db:migrate:remote": "bun --filter @owotv/web db:migrate:remote",
    "test": "bun --filter \"./packages/*\" test",
    "typecheck": "bun --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "owotv": "node apps/cli/bin/owotv.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7",
    "vite": "^8.3.8"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
