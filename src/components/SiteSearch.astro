---
import { Icon } from 'astro-icon/components'
import { SITE } from '@/consts'
---

<div class="site-search" id="site-search">
  <button
    type="button"
    class="site-search-mobile-trigger"
    id="site-search-mobile-trigger"
    aria-label={`Search ${SITE.TITLE}`}
  >
    <Icon name="lucide:search" class="size-4" />
  </button>

  <label class="site-search-box" aria-label={`Search ${SITE.TITLE}`}>
    <Icon name="lucide:search" class="site-search-icon size-4 shrink-0" />
    <span class="site-search-hint">Search {SITE.TITLE}…</span>
    <input
      type="search"
      placeholder={`Search ${SITE.TITLE}…`}
      class="site-search-input"
      id="site-search-input"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="site-search-results"
      aria-autocomplete="list"
    />
    <kbd class="site-search-kbd" id="site-search-kbd" aria-hidden="true">/</kbd>
  </label>
  <div
    class="site-search-dropdown"
    id="site-search-results"
    role="listbox"
    aria-label="Search results"
  >
    <div class="site-search-empty" id="site-search-empty">
      <Icon name="lucide:search-x" class="size-5 opacity-40" />
      <span>No results found</span>
    </div>
  </div>
</div>

<div class="site-search-overlay" id="site-search-overlay" aria-hidden="true"></div>

<script>
  import {
    queryTerms,
    scoreSearchItem,
    type SearchIndexItem,
    type SearchResultType,
  } from '@/lib/search'

  let searchIndex: SearchIndexItem[] | null = null
  let activeIndex = -1
  let isOpen = false
  let searchAbort: AbortController | null = null

  const desktopMedia = window.matchMedia('(min-width: 40rem)')

  async function loadIndex() {
    if (searchIndex) return
    try {
      const res = await fetch('/search-index.json')
      searchIndex = await res.json()
    } catch {
      searchIndex = []
    }
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  function highlightMatch(text: string, query: string): string {
    if (!query.trim()) return escapeHtml(text)
    const terms = queryTerms(query)
    if (terms.length === 0) return escapeHtml(text)
    const escaped = terms.map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    const pattern = new RegExp(`(${escaped.join('|')})`, 'gi')
    return escapeHtml(text).replace(pattern, '<mark>$1</mark>')
  }

  function resultIconMarkup(type: SearchResultType): string {
    switch (type) {
      case 'vod':
        return '<polygon points="6 3 20 12 6 21 6 3"/>'
      case 'game':
        return '<line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/>'
      case 'show':
      case 'episode':
        return '<path d="m17 2-5 5-5-5"/><rect width="20" height="15" x="2" y="7" rx="2"/>'
      case 'date':
        return '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>'
      default:
        return '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>'
    }
  }

  function initSiteSearch() {
    searchAbort?.abort()
    searchAbort = new AbortController()
    const { signal } = searchAbort

    const wrapper = document.getElementById('site-search')
    if (!wrapper) return

    const searchBox = wrapper.querySelector('.site-search-box')
    const input = document.getElementById('site-search-input')
    const dropdown = document.getElementById('site-search-results')
    const emptyEl = document.getElementById('site-search-empty')
    const overlay = document.getElementById('site-search-overlay')
    const kbdHint = document.getElementById('site-search-kbd')
    const mobileTrigger = document.getElementById('site-search-mobile-trigger')
    if (
      !(searchBox instanceof HTMLLabelElement) ||
      !(input instanceof HTMLInputElement) ||
      !dropdown ||
      !emptyEl ||
      !overlay ||
      !kbdHint ||
      !mobileTrigger
    ) {
      return
    }

    const els = {
      wrapper,
      searchBox,
      input,
      dropdown,
      emptyEl,
      overlay,
      kbdHint,
      mobileTrigger,
    }

    activeIndex = -1
    isOpen = false

    function setExpanded(expanded: boolean) {
      els.searchBox.classList.toggle('is-expanded', expanded)
    }

    function syncExpanded() {
      if (!desktopMedia.matches) {
        setExpanded(els.wrapper.classList.contains('is-mobile-open'))
        return
      }

      const shouldExpand =
        document.activeElement === els.input ||
        isOpen ||
        els.input.value.trim().length > 0
      setExpanded(shouldExpand)
    }

    function closeResults() {
      isOpen = false
      els.dropdown.classList.remove('visible')
      els.wrapper.classList.remove('is-open')
      els.input.setAttribute('aria-expanded', 'false')
      els.overlay.classList.remove('visible')
      document.documentElement.removeAttribute('data-search-open')
      activeIndex = -1
      setTimeout(() => {
        if (signal.aborted || !isOpen) return
        els.dropdown.style.display = 'none'
      }, 200)
      syncExpanded()
    }

    function dismissSearch() {
      closeResults()
      closeMobileSearch()
      els.input.value = ''
      if (desktopMedia.matches) els.kbdHint.style.display = ''
      syncExpanded()
    }

    function renderResults(query: string) {
    if (!searchIndex) return

    const q = query.trim()
    if (!q) {
      closeResults()
      return
    }

    const scored = searchIndex
      .map((item) => ({ item, score: scoreSearchItem(item, q) }))
      .filter((result) => result.score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score
        const aDate = a.item.date ?? ''
        const bDate = b.item.date ?? ''
        return bDate.localeCompare(aDate)
      })
      .slice(0, 8)

    els.dropdown.querySelectorAll('.site-search-result, .site-search-results-header').forEach((el) => el.remove())
    activeIndex = -1

    if (scored.length === 0) {
      els.emptyEl.style.display = 'flex'
      openDropdown()
      return
    }

    els.emptyEl.style.display = 'none'

    const header = document.createElement('div')
    header.className = 'site-search-results-header'
    header.innerHTML = `<span>${scored.length} result${scored.length === 1 ? '' : 's'}</span>`
    els.dropdown.appendChild(header)

    scored.forEach((result, index) => {
      const link = document.createElement('a')
      link.href = result.item.href
      link.className = 'site-search-result'
      link.setAttribute('role', 'option')
      link.setAttribute('aria-selected', 'false')
      link.id = `site-search-result-${index}`
      link.dataset.astroTransition = 'animate'

      link.innerHTML = `
        <span class="site-search-result-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${resultIconMarkup(result.item.type)}</svg>
        </span>
        <span class="site-search-result-body">
          <span class="site-search-result-title">${highlightMatch(result.item.title, q)}</span>
          <span class="site-search-result-meta">
            <span class="site-search-result-category">${escapeHtml(result.item.category)}</span>
            <span class="site-search-result-dot" aria-hidden="true">•</span>
            <span class="site-search-result-subtitle">${escapeHtml(result.item.subtitle)}</span>
          </span>
        </span>
        <span class="site-search-result-arrow" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </span>
      `

      link.addEventListener('mouseenter', () => setActive(index))
      els.dropdown.appendChild(link)
    })

    openDropdown()
  }

    function openMobileSearch() {
      els.wrapper.classList.add('is-mobile-open')
      setExpanded(true)
      els.overlay.classList.add('visible')
      els.input.focus()
    }

    function closeMobileSearch() {
      els.wrapper.classList.remove('is-mobile-open')
      if (!isOpen) els.overlay.classList.remove('visible')
      syncExpanded()
    }

    function openDropdown() {
      if (isOpen) return
      isOpen = true
      els.wrapper.classList.add('is-open')
      syncExpanded()
      els.dropdown.style.display = 'block'
      els.input.setAttribute('aria-expanded', 'true')
      els.overlay.classList.add('visible')
      els.kbdHint.style.display = 'none'
      document.documentElement.setAttribute('data-search-open', '')
      requestAnimationFrame(() => els.dropdown.classList.add('visible'))
    }

    function setActive(index: number) {
      const items = els.dropdown.querySelectorAll('.site-search-result')
    items.forEach((element, itemIndex) => {
      element.classList.toggle('active', itemIndex === index)
      element.setAttribute('aria-selected', itemIndex === index ? 'true' : 'false')
    })
    activeIndex = index
    if (index >= 0 && items[index]) {
      els.input.setAttribute('aria-activedescendant', `site-search-result-${index}`)
      items[index].scrollIntoView({ block: 'nearest' })
    } else {
      els.input.removeAttribute('aria-activedescendant')
    }
    }

    function isTypingTarget(): boolean {
    const active = document.activeElement
    if (!active) return false
    const tag = active.tagName.toLowerCase()
    return (
      tag === 'input' ||
      tag === 'textarea' ||
      tag === 'select' ||
      (active as HTMLElement).isContentEditable
    )
  }

    els.input.addEventListener(
      'focus',
      async () => {
        await loadIndex()
        setExpanded(true)
        if (els.input.value.trim()) renderResults(els.input.value)
        els.kbdHint.style.display = 'none'
      },
      { signal },
    )

    els.input.addEventListener(
      'input',
      () => {
        syncExpanded()
        renderResults(els.input.value)
      },
      { signal },
    )

    els.input.addEventListener(
      'keydown',
      (event) => {
        const items = els.dropdown.querySelectorAll('.site-search-result')
    const count = items.length

    if (event.key === 'ArrowDown') {
      event.preventDefault()
      if (!isOpen && els.input.value.trim()) {
        renderResults(els.input.value)
        return
      }
      setActive(activeIndex < count - 1 ? activeIndex + 1 : 0)
    } else if (event.key === 'ArrowUp') {
      event.preventDefault()
      setActive(activeIndex > 0 ? activeIndex - 1 : count - 1)
    } else if (event.key === 'Enter') {
      if (activeIndex >= 0 && items[activeIndex]) {
        event.preventDefault()
        ;(items[activeIndex] as HTMLAnchorElement).click()
      }
    } else if (event.key === 'Escape') {
      event.preventDefault()
        dismissSearch()
        els.input.blur()
      }
      },
      { signal },
    )

    els.input.addEventListener(
      'blur',
      () => {
        setTimeout(() => {
          if (signal.aborted) return
          if (!els.wrapper.contains(document.activeElement)) {
            dismissSearch()
          }
        }, 150)
      },
      { signal },
    )

    desktopMedia.addEventListener('change', syncExpanded, { signal })

    els.overlay.addEventListener(
      'click',
      () => {
        dismissSearch()
        els.input.blur()
      },
      { signal },
    )

    els.mobileTrigger.addEventListener(
      'click',
      async () => {
        await loadIndex()
        openMobileSearch()
        if (els.input.value.trim()) renderResults(els.input.value)
      },
      { signal },
    )

    document.addEventListener(
      'keydown',
      async (event) => {
        if (event.key !== '/' || isTypingTarget()) return
        event.preventDefault()
        await loadIndex()
        if (window.matchMedia('(max-width: 39.99rem)').matches) {
          openMobileSearch()
        } else {
          els.input.focus()
        }
      },
      { signal },
    )

    dismissSearch()
    syncExpanded()
  }

  initSiteSearch()
  document.addEventListener('astro:page-load', initSiteSearch)
</script>

<style>
  .site-search {
    position: relative;
  }

  /* Mobile: icon trigger only until opened */
  .site-search-mobile-trigger {
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.5rem;
    background-color: hsl(var(--secondary) / 0.4);
    color: hsl(var(--muted-foreground));
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .site-search-mobile-trigger:hover {
    background-color: hsl(var(--secondary) / 0.6);
    color: hsl(var(--foreground));
  }

  .site-search-box {
    display: none;
    align-items: center;
    gap: 0;
    height: 2.25rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.5rem;
    background-color: hsl(var(--secondary) / 0.4);
    color: hsl(var(--muted-foreground));
    cursor: text;
    transition:
      width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      min-width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      gap 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      padding 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  .site-search-icon {
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .site-search-hint {
    display: none;
  }

  .site-search-input {
    min-width: 0;
    border: none;
    background: transparent;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: hsl(var(--foreground));
    transition:
      width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease,
      margin 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-search-input::placeholder {
    color: hsl(var(--muted-foreground));
  }

  .site-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .site-search-kbd {
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.25rem;
    background-color: hsl(var(--background));
    padding: 0.1rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
    pointer-events: none;
    white-space: nowrap;
    transition:
      width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease,
      margin 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      padding 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (width < 40rem) {
    .site-search.is-mobile-open {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 300;
      padding: 0.65rem 0.75rem 0;
      background: hsl(var(--background));
    }

    .site-search.is-mobile-open .site-search-mobile-trigger {
      display: none;
    }

    .site-search.is-mobile-open .site-search-box {
      display: flex;
      width: 100%;
      min-width: 0;
      gap: 0.5rem;
      padding: 0 0.75rem;
    }

    .site-search.is-mobile-open .site-search-hint {
      display: none;
    }

    .site-search.is-mobile-open .site-search-input {
      display: block;
      width: 100%;
      flex: 1;
      opacity: 1;
      margin: 0;
    }

    .site-search.is-mobile-open .site-search-kbd {
      display: none;
    }

    .site-search.is-mobile-open .site-search-dropdown {
      position: fixed;
      top: 3.25rem;
      right: 0.5rem;
      left: 0.5rem;
      width: auto;
    }
  }

  @media (width >= 40rem) {
    .site-search-mobile-trigger {
      display: none;
    }

    .site-search-hint {
      display: block;
      flex: 1;
      min-width: 0;
      overflow: hidden;
      font-size: 0.875rem;
      line-height: 1;
      color: hsl(var(--muted-foreground));
      text-overflow: ellipsis;
      white-space: nowrap;
      pointer-events: none;
      transition: opacity 0.2s ease, max-width 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .site-search-box {
      display: flex;
      width: 11.75rem;
      min-width: 11.75rem;
      gap: 0.45rem;
      padding: 0 0.65rem;
    }

    .site-search-box.is-expanded {
      width: 13.5rem;
      min-width: 13.5rem;
      padding: 0 0.75rem;
    }

    .site-search-box.is-expanded .site-search-hint {
      display: none;
      flex: 0;
      width: 0;
      opacity: 0;
    }

    .site-search-input {
      display: block;
      width: 0;
      flex: 0;
      opacity: 0;
      margin: 0;
    }

    .site-search-box.is-expanded .site-search-input {
      width: 8.75rem;
      flex: 1;
      opacity: 1;
    }

    .site-search-kbd {
      flex-shrink: 0;
      width: auto;
      opacity: 0.85;
    }

    .site-search-box.is-expanded .site-search-kbd {
      width: 0;
      opacity: 0;
      margin: 0;
      padding: 0;
      border-width: 0;
    }
  }

  @media (width >= 64rem) {
    .site-search-box {
      width: 12.5rem;
      min-width: 12.5rem;
    }

    .site-search-box.is-expanded {
      width: 15.5rem;
      min-width: 15.5rem;
    }

    .site-search-box.is-expanded .site-search-input {
      width: 10.75rem;
    }
  }

  .site-search-box:focus-within,
  .site-search-box.is-expanded,
  .site-search.is-open .site-search-box {
    border-color: hsl(var(--ring) / 0.55);
    background-color: hsl(var(--secondary) / 0.65);
    color: hsl(var(--foreground));
    box-shadow: 0 0 0 3px hsl(var(--ring) / 0.18);
  }

  .site-search-box:focus-within .site-search-icon,
  .site-search-box.is-expanded .site-search-icon {
    opacity: 1;
    color: hsl(var(--accent));
  }

  .site-search-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 200;
    width: min(26rem, calc(100vw - 2rem));
    max-height: 28rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background-color: hsl(var(--card));
    box-shadow:
      0 16px 48px hsl(250 15% 2% / 0.45),
      0 4px 12px hsl(250 15% 2% / 0.25);
    opacity: 0;
    transform: translateY(-0.35rem) scale(0.98);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .site-search-dropdown.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .site-search-dropdown::-webkit-scrollbar {
    width: 5px;
  }

  .site-search-dropdown::-webkit-scrollbar-thumb {
    border-radius: 3px;
    background: hsl(var(--border));
  }

  .site-search-dropdown :global(.site-search-results-header) {
    padding: 0.65rem 0.9rem 0.45rem;
    border-bottom: 1px solid hsl(var(--border) / 0.7);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    user-select: none;
  }

  .site-search-dropdown :global(.site-search-result) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0.2rem 0.35rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.5rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition:
      background-color 0.14s ease,
      color 0.14s ease;
  }

  .site-search-dropdown :global(.site-search-result:hover),
  .site-search-dropdown :global(.site-search-result.active) {
    background-color: hsl(var(--secondary) / 0.85);
  }

  .site-search-dropdown :global(.site-search-result.active .site-search-result-title) {
    color: hsl(var(--accent));
  }

  .site-search-dropdown :global(.site-search-result.active .site-search-result-icon) {
    border-color: hsl(var(--accent) / 0.35);
    background-color: hsl(var(--accent) / 0.12);
    color: hsl(var(--accent));
  }

  .site-search-dropdown :global(.site-search-result.active .site-search-result-arrow) {
    opacity: 1;
    transform: translateX(0);
  }

  .site-search-dropdown :global(.site-search-result-icon) {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 0.4rem;
    background-color: hsl(var(--secondary) / 0.55);
    color: hsl(var(--muted-foreground));
    transition:
      background-color 0.14s ease,
      border-color 0.14s ease,
      color 0.14s ease;
  }

  .site-search-dropdown :global(.site-search-result-body) {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.1rem;
  }

  .site-search-dropdown :global(.site-search-result-title) {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.14s ease;
  }

  .site-search-dropdown :global(.site-search-result-meta) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.35rem;
  }

  .site-search-dropdown :global(.site-search-result-category) {
    flex-shrink: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
