---
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  /** `xl` matches browse/list pages; `2xl` matches header/footer */
  size?: 'xl' | '2xl'
}

const { class: className, size = 'xl' } = Astro.props

const maxWidth =
  size === '2xl' ? 'max-w-(--breakpoint-2xl)' : 'max-w-(--breakpoint-xl)'
---

<div
  class={cn('mx-auto w-full px-4 sm:px-6 lg:px-8', maxWidth, className)}
>
  <slot />
</div>
