---
import { Icon } from 'astro-icon/components'

const links = [
  {
    href: '/vods',
    label: 'VODs',
    description: 'All archived streams',
    icon: 'lucide:video',
  },
  {
    href: '/shows',
    label: 'Shows',
    description: 'Curated playlists',
    icon: 'lucide:tv',
  },
  {
    href: '/games',
    label: 'Games',
    description: 'Browse by game',
    icon: 'lucide:gamepad-2',
  },
  {
    href: '/collection',
    label: 'Collections',
    description: 'Browse by month and year',
    icon: 'lucide:calendar',
  },
]
---

<div
  class="grid h-full min-h-64 auto-rows-fr grid-cols-2 gap-2 rounded-2xl border border-border/50 bg-card/40 p-4 sm:min-h-72 sm:p-5"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class="group flex h-full min-h-28 flex-col justify-between gap-4 rounded-xl border border-border/40 bg-background/50 p-4 transition-colors hover:border-border hover:bg-secondary/50"
      >
        <span class="flex items-start justify-between gap-2">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-secondary text-muted-foreground transition-colors group-hover:text-foreground">
            <Icon name={link.icon} class="size-5" />
          </span>
          <Icon
            name="lucide:arrow-up-right"
            class="size-4 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100"
          />
        </span>
        <span class="min-w-0">
          <span class="block font-medium leading-tight">{link.label}</span>
          <span class="block text-xs leading-snug text-muted-foreground">
            {link.description}
          </span>
        </span>
      </a>
    ))
  }
</div>
