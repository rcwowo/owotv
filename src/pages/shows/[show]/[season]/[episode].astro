---
import { buttonVariants } from '@/components/ui/button'
import { EpisodePlaylist } from '@/components/shows/EpisodePlaylist'
import MinimalLayout from '@/layouts/MinimalLayout.astro'
import { getYouTubeVideoID } from '@/lib/utils'
import { getShow } from '@/lib/shows'
import { getDb } from '@/lib/db'
import { Icon } from 'astro-icon/components'

const db = getDb()
const { show, season: seasonId, episode: episodeId } = Astro.params
const showEntry =
  show !== undefined ? await getShow(db, show) : null
const season =
  showEntry?.seasons.find((s) => s.id === seasonId) ?? null
const episode =
  season?.episodes.find((e) => e.id === episodeId) ?? null

if (!showEntry || !season || !episode) {
  return Astro.rewrite('/404')
}

const youtubeId = getYouTubeVideoID(episode.videoUrl)
---

<MinimalLayout
  title={`${episode.title} - ${showEntry.name}`}
  description={`Watch ${showEntry.name}: ${episode.title}`}
  image={episode.thumbnailUrl}
>
  <main class="flex h-screen flex-col bg-background">
    <div class="flex items-center justify-between border-b bg-background p-4">
      <a
        href={`/shows/${showEntry.slug}`}
        class={buttonVariants({ variant: 'outline', size: 'sm' })}
      >
        <Icon name="lucide:chevron-left" class="md:mr-2 size-4" />
        <span class="hidden md:inline">Back to {showEntry.name}</span>
      </a>
      <div class="flex items-center gap-4 text-right">
        <div>
          <h1 class="truncate text-sm font-semibold">{episode.title}</h1>
          <p class="truncate text-xs text-muted-foreground">
            {showEntry.name} • {season.title}
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-1 overflow-hidden">
      <div class="flex flex-1 flex-col bg-black relative">
        <div class="flex-1 flex items-center justify-center">
        {
            youtubeId ? (
                <iframe
                    src={`https://www.youtube.com/embed/${youtubeId}?autoplay=1&modestbranding=1&rel=0`}
                    title={episode.title}
                    class="h-full w-full max-h-screen aspect-video"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                />
            ) : (
                <div class="flex h-full items-center justify-center text-muted-foreground">
                    <p>Invalid Video URL</p>
                </div>
            )
        }
        </div>
      </div>

        <EpisodePlaylist 
            client:load 
            show={showEntry} 
            currentSeasonId={season.id} 
            currentEpisodeId={episode.id} 
        />
    </div>
  </main>
</MinimalLayout>
