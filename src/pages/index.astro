---
import Container from '@/components/Container.astro'
import ContentRow from '@/components/ContentRow.astro'
import ExplorePanel from '@/components/ExplorePanel.astro'
import FaqAccordion from '@/components/FaqAccordion'
import Footer from '@/components/Footer.astro'
import ShowCard from '@/components/shows/ShowCard.astro'
import { buttonVariants } from '@/components/ui/button'
import GameCard from '@/components/vods/GameCard.astro'
import VodCard from '@/components/vods/VodCard.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { formatStreamDate } from '@/lib/date'
import { getShows } from '@/lib/shows'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

const allVods = await getCollection('vods')
const sortedVods = allVods.sort(
  (a, b) => b.data['Stream Date'].valueOf() - a.data['Stream Date'].valueOf(),
)

const latestVods = sortedVods.slice(0, 12)
const featuredVod = sortedVods[0]
const shows = await getShows()

const vodsByGame = sortedVods.reduce(
  (
    acc: Record<
      string,
      { vods: typeof sortedVods; coverUrl: string; latestDate: Date }
    >,
    vod,
  ) => {
    const game = vod.data['Game'] || 'Other'
    if (!acc[game]) {
      acc[game] = {
        vods: [],
        coverUrl: vod.data['Game Cover URL'] || '',
        latestDate: vod.data['Stream Date'],
      }
    }
    acc[game].vods.push(vod)
    return acc
  },
  {} as Record<
    string,
    { vods: typeof sortedVods; coverUrl: string; latestDate: Date }
  >,
)

const recentGames = Object.entries(vodsByGame)
  .sort((a, b) => b[1].latestDate.valueOf() - a[1].latestDate.valueOf())
  .slice(0, 12)
---

<Layout
  title="Home"
  description={SITE.DESCRIPTION}
  image={featuredVod?.data['Thumbnail URL']}
  headerOverlay
  className="gap-y-0"
>
  {
    featuredVod && (
      <section class="relative h-[min(52vh,32rem)] min-h-80 max-h-128">
        <div class="absolute inset-0 overflow-hidden">
          <img
            src={featuredVod.data['Thumbnail URL']}
            alt=""
            class="h-full w-full scale-105 object-cover blur-[2px]"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-linear-to-t from-background via-background/75 to-background/25" />
          <div class="absolute inset-0 bg-linear-to-r from-background/85 via-transparent to-background/35" />
        </div>

        <div class="relative flex h-full flex-col justify-end pb-8 pt-16 sm:pb-10">
          <Container class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="max-w-3xl space-y-4">
              <h1 class="font-display text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl md:text-4xl lg:text-[2.5rem]">
                {featuredVod.data['Title']}
              </h1>
              <p class="text-sm text-muted-foreground">
                Streamed on {formatStreamDate(featuredVod.data['Stream Date'])} •{' '}
                {featuredVod.data['Duration']}
              </p>
              <a
                href={`/watch/${featuredVod.id}`}
                class={cn(
                  buttonVariants({ variant: 'secondary', size: 'lg' }),
                  'h-10 gap-2 rounded-full bg-primary px-5 text-primary-foreground shadow-lg hover:bg-primary/90 sm:h-11 sm:px-6',
                )}
              >
                <Icon name="lucide:eye" class="size-4" />
                Watch VOD
              </a>
            </div>

            {
              featuredVod.data['Game Cover URL'] && (
                <a
                  href={`/games/${(featuredVod.data['Game'] || 'Other').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  class="group hidden shrink-0 sm:block"
                >
                  <img
                    src={featuredVod.data['Game Cover URL']}
                    alt={featuredVod.data['Game']}
                    class="h-36 w-auto rounded-xl border border-white/10 shadow-2xl transition-transform duration-300 group-hover:scale-[1.03] lg:h-40"
                    width="120"
                    height="176"
                  />
                </a>
              )
            }
          </Container>
        </div>
      </section>
    )
  }

  <div class="space-y-10 bg-background py-8 sm:space-y-12 sm:py-10">
    <ContentRow title="Latest VODs" viewAllHref="/vods">
      {
        latestVods.map((vod) => (
          <div class="w-72 shrink-0 sm:w-80">
            <VodCard vod={vod} />
          </div>
        ))
      }
    </ContentRow>

    {
      shows.length > 0 && (
        <ContentRow title="Featured Shows" viewAllHref="/shows">
          {shows.map((show) => (
            <div class="w-72 shrink-0 sm:w-80">
              <ShowCard show={show} />
            </div>
          ))}
        </ContentRow>
      )
    }

    <ContentRow title="Recently Played Games" viewAllHref="/games">
      {
        recentGames.map(([game, { vods: gameVods, coverUrl }]) => (
          <div class="w-28 shrink-0 sm:w-32">
            <GameCard
              game={game}
              coverUrl={coverUrl}
              vodCount={gameVods.length}
            />
          </div>
        ))
      }
    </ContentRow>

    <Container>
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
        <div class="flex flex-col gap-4">
          <h2 class="font-display text-xl font-bold tracking-tight sm:text-2xl">
            Explore {SITE.TITLE}
          </h2>
          <ExplorePanel />
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="font-display text-xl font-bold tracking-tight sm:text-2xl">
            Frequently Asked Questions
          </h2>
          <div
            class="min-h-64 rounded-2xl border border-border/50 bg-card/40 p-4 sm:min-h-72 sm:p-5"
          >
            <FaqAccordion siteTitle={SITE.TITLE} client:load />
          </div>
        </div>
      </div>
    </Container>
  </div>

  <Footer />
</Layout>
