---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Layout from '@/layouts/Layout.astro'
import VodCard from '@/components/vods/VodCard.astro'
import { getDb, getVods } from '@/lib/db'

const db = getDb()
const sortedVods = (await getVods(db)).sort(
  (a, b) => b.streamDate.valueOf() - a.streamDate.valueOf(),
)

const gameData = sortedVods.reduce((acc: Record<string, { vods: typeof sortedVods; coverUrl: string }>, vod) => {
  const game = vod.game || 'Other'
  if (!acc[game]) {
    acc[game] = {
      vods: [],
      coverUrl: vod.gameCoverUrl || ''
    }
  }
  acc[game].vods.push(vod)
  return acc
}, {})

const slugifyGame = (game: string) =>
  game.toLowerCase().replace(/[^a-z0-9]+/g, '-')

const entry = Object.entries(gameData).find(
  ([game]) => slugifyGame(game) === Astro.params.game,
)

if (!entry) return Astro.rewrite('/404')

const [game, { vods, coverUrl }] = entry
---

<Layout 
  title={`${game} VODs`} 
  description={`Archive of Twitch streams playing ${game}`}
  image={coverUrl}
>
  <main class="mx-auto max-w-(--breakpoint-xl) px-4 sm:px-6 lg:px-8">
    <div class="py-4">
      <Breadcrumbs
        items={[
          { href: '/games', label: 'Games', icon: 'lucide:gamepad-2'},
          { label: game, icon: 'lucide:gamepad' },
        ]}
      />
    </div>
    <div class="flex flex-row items-center mb-8">
      {coverUrl && <img src={coverUrl} alt="" class="aspect-3/4 max-h-32 mr-4 rounded-xl object-cover" />}
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold flex items-center">
          {game}
        </h1>
        <p class="text-muted-foreground">
          {vods.length} stream{vods.length === 1 ? '' : 's'}
        </p>
      </div>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {vods.map((vod) => (
        <VodCard vod={vod} />
      ))}
    </div>
  </main>
</Layout>
