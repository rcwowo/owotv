---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Layout from '@/layouts/Layout.astro'
import VodCard from '@/components/vods/VodCard.astro'
import { getDb, getVods } from '@/lib/db'

const db = getDb()
const sortedVods = (await getVods(db)).sort(
  (a, b) => b.streamDate.valueOf() - a.streamDate.valueOf(),
)

const formatMonthYear = (date: Date) =>
  date.toLocaleString('en-US', {
    month: 'long',
    year: 'numeric',
  })

const monthYears = [...new Set(sortedVods.map((vod) => formatMonthYear(vod.streamDate)))]

const findMonthVods = (monthYear: string) =>
  sortedVods.filter((vod) => formatMonthYear(vod.streamDate) === monthYear)

const entry = monthYears.find(
  (monthYear) => monthYear.toLowerCase().replace(' ', '-') === Astro.params.monthYear,
)

if (!entry) return Astro.rewrite('/404')

const monthYear = entry
const vods = findMonthVods(monthYear)
---

<Layout title={`${monthYear} VODs`} description={`Archive of Twitch streams from ${monthYear}`}>
  <main class="mx-auto max-w-(--breakpoint-xl) px-4 sm:px-6 lg:px-8">
    <div class="py-4">
      <Breadcrumbs
        items={[
          { href: '/collection', label: 'Collections', icon: 'lucide:folder'},
          { label: monthYear, icon: 'lucide:calendar' },
        ]}
      />
    </div>
    <h1 class="mb-8 text-4xl font-bold">{monthYear} VODs</h1>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {vods.map((vod) => (
        <VodCard vod={vod} />
      ))}
    </div>
  </main>
</Layout>
