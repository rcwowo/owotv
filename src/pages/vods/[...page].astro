---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PaginationComponent from '@/components/ui/pagination'
import VodCard from '@/components/vods/VodCard.astro'
import { getDb, getVods } from '@/lib/db'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'

const db = getDb()
const allVods = (await getVods(db)).sort(
  (a, b) => b.streamDate.valueOf() - a.streamDate.valueOf(),
)

const pageSize = SITE.VODS_PER_PAGE
const total = allVods.length
const lastPage = Math.max(1, Math.ceil(total / pageSize))

const pageParam = Astro.params.page
let currentPage = 1
if (pageParam) {
  if (!/^\d+$/.test(pageParam)) return Astro.rewrite('/404')
  currentPage = parseInt(pageParam, 10)
  if (currentPage < 1 || currentPage > lastPage) return Astro.rewrite('/404')
}

const page = {
  data: allVods.slice((currentPage - 1) * pageSize, currentPage * pageSize),
  currentPage,
  lastPage: lastPage,
}
---

<Layout title="Browse" description="Archive of all Twitch streams">
  <main class="mx-auto max-w-(--breakpoint-xl) px-4 sm:px-6 lg:px-8">
    <div class="py-4 space-y-4">
      <Breadcrumbs
        items={[
          { label: `Page ${page.currentPage}`, icon: 'lucide:folder-open' }
        ]}
      />
      <h1 class="text-4xl font-bold tracking-tight">VODs</h1>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((vod) => <VodCard vod={vod} />)}
    </div>

    <div class="py-4">
      <PaginationComponent
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/vods/"
        client:load
      />
    </div>
  </main>
</Layout>
