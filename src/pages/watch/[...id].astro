---
import ChatReplay from '@/components/vods/chat-replay/ChatReplay'
import WatchShareButton from '@/components/vods/WatchShareButton'
import YouTubeWatchPlayer from '@/components/vods/YouTubeWatchPlayer'
import { buttonVariants } from '@/components/ui/button'
import MinimalLayout from '@/layouts/MinimalLayout.astro'
import { getYouTubeVideoID } from '@/lib/utils'
import { getYouTubePlayerElementId } from '@/lib/youtube-api'
import { Icon } from 'astro-icon/components'
import { getDb, getVod } from '@/lib/db'
import { cn } from '@/lib/utils'

const db = getDb()
const { id } = Astro.params
const vod = id ? await getVod(db, id) : null
if (!vod) return Astro.rewrite('/404')

const youtubeId = getYouTubeVideoID(vod.vodUrl)

const { CHATLOGS_URL } = import.meta.env
let chatReplayUrl: string | undefined

if (vod.chatReplayPath && CHATLOGS_URL) {
  chatReplayUrl = new URL(
    vod.chatReplayPath.replace(/^\//, ''),
    CHATLOGS_URL.endsWith('/') ? CHATLOGS_URL : `${CHATLOGS_URL}/`,
  ).href
}

const playerElementId = youtubeId ? getYouTubePlayerElementId(youtubeId) : ''
---

<MinimalLayout
  title={vod.title}
  description={`Stream VOD: ${vod.title}`}
  image={vod.thumbnailUrl}
>
  <main class="flex h-screen flex-col bg-background">
    <div class="flex items-center justify-between border-b p-4">
      <div class="flex items-center gap-2">
        <button
          class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'cursor-pointer')}
          onclick="(function(){try{if(window.history.length>1){window.history.back()}else{window.location.href='/'}}catch(e){window.location.href='/'}})()"
        >
          <Icon name="lucide:chevron-left" class="md:mr-2 size-4" />
          <span class="hidden md:inline">Go Back</span>
        </button>
        <WatchShareButton client:load />
      </div>
      <div class="flex items-center gap-4 text-right">
        <div class="max-w-[70vw]">
          <h1 class="truncate text-sm font-semibold">{vod.title}</h1>
          <p class="truncate text-xs text-muted-foreground">
            {vod.game} • {
              vod.streamDate.toLocaleString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })
            }
          </p>
        </div>
        <img
          src={vod.gameCoverUrl}
          alt={`Game cover for ${vod.game}`}
          width="32"
          height="32"
          class="size-8 rounded object-cover"
        />
      </div>
    </div>

    <div class="flex flex-1 overflow-hidden">
      <div class="relative flex flex-1 flex-col bg-black">
        <div class="relative h-full w-full">
          {
            youtubeId && (
              <>
                <div
                  id={playerElementId}
                  class="absolute left-0 top-0 h-full w-full"
                />
                <YouTubeWatchPlayer client:load youtubeId={youtubeId} />
              </>
            )
          }
        </div>
      </div>

      {
        chatReplayUrl && (
          <ChatReplay client:load chatReplayURL={chatReplayUrl} />
        )
      }
    </div>
  </main>
</MinimalLayout>
