---
/**
 * Interactive API documentation, rendered by Scalar's standalone build.
 *
 * The Scalar bundle is vendored locally (no CDN at runtime):
 *   @scalar/api-reference@1.72.3, dist/browser/standalone.min.js
 *   fetched from https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.72.3/dist/browser/standalone.min.js
 *   sha256: f98a66f9d9613398fd6eb58be8f25594d7e8861e71ea11bca94d67ae9fa5567f
 * Scalar is MIT-licensed (https://github.com/scalar/scalar), so checking in the
 * static build is permitted. The `withDefaultFonts: false` configuration keeps
 * the bundle from pulling fonts.scalar.com at runtime — typography falls back
 * to the system stack, and every request the page makes after load stays
 * same-origin (/api/v1/openapi.json and the "try it" calls only).
 */
export const prerender = false
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/static/favicon.png" />
    <title>owotv API — Reference</title>
    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: #0b0a10;
      }
    </style>
  </head>
  <body>
    <script
      id="api-reference"
      type="application/json"
      data-configuration='{
        "spec": { "url": "/api/v1/openapi.json" },
        "theme": "purple",
        "darkMode": true,
        "withDefaultFonts": false,
        "metaData": {
          "title": "owotv API",
          "description": "Management API for the owoTV VOD archive (D1 + R2).",
          "downloadFileName": "owotv-openapi"
        }
      }'
    ></script>
    <script
      is:inline
      src="/api-docs/scalar-standalone-1.72.3.min.js"
    ></script>
  </body>
</html>
