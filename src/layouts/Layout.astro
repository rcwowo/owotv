---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { cn } from '@/lib/utils'
import { SITE } from '@/consts'

type Props = {
  title: string
  description: string
  image?: string,
  className?: string
}

const { title, description, image, className } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} - ${SITE.TITLE}`}
      description={description}
      image={image}
    />
  </head>
  <body>
    <div
      class={cn("box-border flex h-fit min-h-screen flex-col gap-y-6 font-sans antialiased", className)}
    >
      <Header />
      <main transition:animate="fade" class="grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
