---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { cn } from '@/lib/utils'
import { SITE } from '@/consts'

type Props = {
  title: string
  description: string
  image?: string
  className?: string
  headerOverlay?: boolean
}

const { title, description, image, className, headerOverlay = false } =
  Astro.props
---

<!doctype html>
<html lang="en" data-header-overlay={headerOverlay ? '' : undefined}>
  <head>
    <Head
      title={`${title} - ${SITE.TITLE}`}
      description={description}
      image={image}
    />
  </head>
  <body>
    <div
      class={cn(
        'box-border flex min-h-screen flex-col font-sans antialiased',
        className,
      )}
    >
      <Header />
      <main transition:animate="fade" class="grow">
        <slot />
      </main>
      {!headerOverlay && <Footer />}
    </div>
  </body>
</html>
