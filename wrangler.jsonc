{
	"name": "owotv-worker",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "owotv",
			"database_id": "78904ed7-8777-44ef-851c-0707285adde2",
			"migrations_dir": "../../migration"
		}
	],
	"r2_buckets": [
		{
			"binding": "CHATLOGS",
			"bucket_name": "owotv",
		}
	]
}