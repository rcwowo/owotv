{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "owotv",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owotv",
      "database_id": "f27c58e5-784b-402a-9430-3a3d410798d6",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "owotv",
    },
  ],
}
