---
import ContentRow from '@/components/ContentRow.astro'
import { channelPath, type ChannelSummary } from '@/lib/channels'
import ChannelAvatar from './ChannelAvatar.astro'

interface Props {
  channels: ChannelSummary[]
}

const { channels } = Astro.props
---

<ContentRow title="Channels" viewAllHref="/channels">
  {channels.map((channel) => (
    <a
      href={channelPath(channel.slug)}
      class="group flex w-24 shrink-0 flex-col items-center gap-2 rounded-xl py-1 text-center outline-none sm:w-28"
    >
      <span class="rounded-full p-0.5 ring-2 ring-border/60 transition-all duration-300 group-hover:ring-primary group-focus-visible:ring-primary">
        <ChannelAvatar
          channel={channel}
          class="size-20 text-2xl transition-transform duration-300 group-hover:scale-[1.04] sm:size-24"
        />
      </span>
      <span class="w-full truncate text-sm font-medium transition-colors group-hover:text-primary">
        {channel.displayName}
      </span>
      <span class="-mt-2 text-xs text-muted-foreground">
        {channel.vodCount} VOD{channel.vodCount === 1 ? '' : 's'}
      </span>
    </a>
  ))}
</ContentRow>
