---
import Container from '@/components/Container.astro'
import { channelPath } from '@/lib/channels'
import { cn } from '@/lib/utils'
import type { ApiChannel } from '@owotv/shared'
import ChannelAvatar from './ChannelAvatar.astro'
import ChannelLinks from './ChannelLinks.astro'

interface Props {
  channel: ApiChannel
  tab: 'vods' | 'shows'
  vodCount: number
  showCount: number
  /** Used as the background when the channel has no banner */
  fallbackImage?: string
}

const { channel, tab, vodCount, showCount, fallbackImage } = Astro.props
const background = channel.bannerUrl ?? fallbackImage ?? channel.avatarUrl
const base = channelPath(channel.slug)
const tabs = [
  { id: 'vods', label: 'VODs', count: vodCount, href: base },
  { id: 'shows', label: 'Shows', count: showCount, href: `${base}/shows` },
] as const
---

<section class="relative">
  <div class="absolute inset-0 overflow-hidden">
    {background && (
      <img
        src={background}
        alt=""
        fetchpriority="high"
        class={cn(
          'h-full w-full object-cover',
          !channel.bannerUrl && 'scale-110 blur-xl opacity-60',
        )}
      />
    )}
    <div class="absolute inset-0 bg-linear-to-t from-background via-background/80 to-background/30"></div>
    <div class="absolute inset-0 bg-linear-to-r from-background/80 via-transparent to-background/40"></div>
  </div>

  <Container class="relative pt-24 sm:pt-32">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:gap-6">
      <ChannelAvatar
        channel={channel}
        loading="eager"
        class="size-24 border-4 border-background text-4xl shadow-2xl sm:size-32 sm:text-5xl"
      />
      <div class="min-w-0 flex-1 space-y-3">
        <div>
          <h1 class="font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            {channel.displayName}
          </h1>
          <p class="text-sm text-muted-foreground">
            {vodCount} VOD{vodCount === 1 ? '' : 's'}
            {showCount > 0 && (
              <>
                {' '}
                • {showCount} show{showCount === 1 ? '' : 's'}
              </>
            )}
          </p>
        </div>
        {channel.description && (
          <p class="max-w-2xl whitespace-pre-line text-sm text-foreground/85 sm:text-base">
            {channel.description}
          </p>
        )}
      </div>
      <ChannelLinks links={channel.links} class="sm:justify-end" />
    </div>

    <nav
      class="mt-6 flex gap-1 border-b border-border/60"
      aria-label="Channel sections"
    >
      {tabs.map((t) => (
        <a
          href={t.href}
          aria-current={t.id === tab ? 'page' : undefined}
          class={cn(
            '-mb-px inline-flex items-center gap-2 border-b-2 px-4 py-2.5 text-sm font-medium transition-colors',
            t.id === tab
              ? 'border-primary text-foreground'
              : 'border-transparent text-muted-foreground hover:text-foreground',
          )}
        >
          {t.label}
          <span class="rounded-full bg-secondary px-2 py-0.5 text-xs text-muted-foreground">
            {t.count}
          </span>
        </a>
      ))}
    </nav>
  </Container>
</section>
