---
import ChatReplay from '@/components/vods/chat-replay/ChatReplay'
import WatchShareButton from '@/components/vods/WatchShareButton'
import YouTubeWatchPlayer from '@/components/vods/YouTubeWatchPlayer'
import { buttonVariants } from '@/components/ui/button'
import MinimalLayout from '@/layouts/MinimalLayout.astro'
import { getYouTubePlayerElementId } from '@/lib/youtube-api'
import { Icon } from 'astro-icon/components'
import ChannelAvatar from '@/components/channels/ChannelAvatar.astro'
import { channelPath, isMultiChannel } from '@/lib/channels'
import { getVod } from '@/lib/data'
import { cn } from '@/lib/utils'

const [vod, multiChannel] = await Promise.all([
  getVod(Astro.params.id ?? ''),
  isMultiChannel(),
])
if (!vod) return new Response(null, { status: 404 })

const youtubeId = vod.youtubeId
const playerElementId = getYouTubePlayerElementId(youtubeId)
---

<MinimalLayout
  title={vod.title}
  description={
    multiChannel
      ? `Stream VOD from ${vod.channel.displayName}: ${vod.title}`
      : `Stream VOD: ${vod.title}`
  }
  image={vod.thumbnailUrl}
>
  <main class="flex h-screen flex-col bg-background">
    <!-- Top Navigation Bar -->
    <div class="flex items-center justify-between border-b p-4">
      <div class="flex items-center gap-2">
        <button
          class={cn(
            buttonVariants({ variant: 'outline', size: 'sm' }),
            'cursor-pointer',
          )}
          onclick="(function(){try{if(window.history.length>1){window.history.back()}else{window.location.href='/'}}catch(e){window.location.href='/'}})()"
        >
          <Icon name="lucide:chevron-left" class="md:mr-2 size-4" />
          <span class="hidden md:inline">Go Back</span>
        </button>
        <WatchShareButton client:load />
      </div>
      <div class="flex items-center gap-4 text-right">
        <div class="max-w-[70vw]">
          <h1 class="truncate text-sm font-semibold">{vod.title}</h1>
          <p class="truncate text-xs text-muted-foreground">
            {multiChannel && (
              <>
                <a
                  href={channelPath(vod.channel.slug)}
                  class="font-medium text-foreground hover:text-primary"
                >
                  {vod.channel.displayName}
                </a>{' '}
                •{' '}
              </>
            )}
            {vod.game?.name ?? 'Other'} •{' '}
            {vod.streamedAt.toLocaleString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            })}
          </p>
        </div>
        {multiChannel && (
          <a
            href={channelPath(vod.channel.slug)}
            title={vod.channel.displayName}
            class="shrink-0"
          >
            <ChannelAvatar channel={vod.channel} class="size-8 text-sm" />
          </a>
        )}
        {vod.game?.coverUrl && (
          <img
            src={vod.game.coverUrl}
            alt={`Game cover for ${vod.game.name}`}
            width="32"
            height="32"
            class="size-8 rounded object-cover"
          />
        )}
      </div>
    </div>

    <!-- Content Area -->
    <div class="flex flex-1 overflow-hidden">
      <!-- Video Player -->
      <div class="relative flex flex-1 flex-col bg-black">
        <div class="relative h-full w-full">
          {youtubeId && (
            <>
              <div
                id={playerElementId}
                class="absolute left-0 top-0 h-full w-full"
              />
              <YouTubeWatchPlayer client:load youtubeId={youtubeId} />
            </>
          )}
        </div>
      </div>

      <!-- Chat Replay -->
      {vod.hasChat && <ChatReplay client:load vodSlug={vod.slug} />}
    </div>
  </main>
</MinimalLayout>
