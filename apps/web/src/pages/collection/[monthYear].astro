---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import VodCard from '@/components/vods/VodCard.astro'
import Layout from '@/layouts/Layout.astro'
import { isMultiChannel } from '@/lib/channels'
import { listVods, parseMonthSlug } from '@/lib/data'

const range = parseMonthSlug(Astro.params.monthYear ?? '')
const [vods, multiChannel] = await Promise.all([
  range ? listVods({ from: range.from, to: range.to }) : [],
  isMultiChannel(),
])
if (!range || vods.length === 0) return new Response(null, { status: 404 })
const monthYear = range.label
---

<Layout
  title={`${monthYear} VODs`}
  description={`Archive of Twitch streams from ${monthYear}`}
>
  <main class="mx-auto max-w-(--breakpoint-xl) px-4 sm:px-6 lg:px-8">
    <div class="py-4">
      <Breadcrumbs
        items={[
          { href: '/collection', label: 'Collections', icon: 'lucide:folder' },
          { label: monthYear, icon: 'lucide:calendar' },
        ]}
      />
    </div>
    <h1 class="mb-8 text-4xl font-bold">{monthYear} VODs</h1>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {vods.map((vod) => (
        <VodCard vod={vod} showChannel={multiChannel} />
      ))}
    </div>
  </main>
</Layout>
